{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chord-garden.dev/schemas/project.schema.json",
  "title": "Project",
  "type": "object",
  "properties": {
    "format": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "ppqn": { "type": "integer", "minimum": 24, "maximum": 15360 },
    "tempoMap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "startTick": { "type": "integer", "minimum": 0 },
          "bpm": { "type": "integer", "minimum": 2000, "maximum": 30000 }
        },
        "required": ["startTick", "bpm"],
        "unevaluatedProperties": false
      }
    },
    "meterMap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "startTick": { "type": "integer", "minimum": 0 },
          "timeSignature": {
            "type": "array",
            "prefixItems": [
              { "type": "integer", "minimum": 1, "maximum": 32 },
              { "enum": [1, 2, 4, 8, 16] }
            ],
            "items": false,
            "minItems": 2
          }
        },
        "required": ["startTick", "timeSignature"],
        "unevaluatedProperties": false
      }
    },
    "key": {
      "type": "object",
      "properties": {
        "root": { "type": "string", "pattern": "^[A-G][#b]?$" },
        "scale": { "enum": ["major", "minor"] }
      },
      "required": ["root", "scale"],
      "unevaluatedProperties": false
    },
    "swing": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "trackOrder": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    }
  },
  "required": ["format", "name", "ppqn", "tempoMap", "meterMap", "swing", "trackOrder"],
  "unevaluatedProperties": false
}
