{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chord-garden.dev/schemas/automation.schema.json",
  "title": "Automation",
  "type": "object",
  "properties": {
    "track": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string" },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "param": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9]*)*$"
          },
          "interp": { "enum": ["linear", "step"] },
          "points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "prefixItems": [
                { "type": "integer", "minimum": 0 },
                { "type": "integer" }
              ],
              "items": false,
              "minItems": 2
            }
          }
        },
        "required": ["param", "interp", "points"],
        "unevaluatedProperties": false
      }
    }
  },
  "required": ["track", "lanes"],
  "unevaluatedProperties": false
}
