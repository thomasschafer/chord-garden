{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chord-garden.dev/schemas/pattern-grid.schema.json",
  "title": "GridPattern",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string" },
    "kind": { "const": "grid" },
    "lengthTicks": { "type": "integer", "minimum": 1 },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "lane": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "grid": {
            "type": "object",
            "properties": {
              "stepsPerBar": { "type": "integer", "minimum": 1, "maximum": 64 }
            },
            "required": ["stepsPerBar"],
            "unevaluatedProperties": false
          },
          "steps": { "type": "string", "minLength": 1 },
          "defaults": {
            "type": "object",
            "properties": {
              "velocity": { "type": "integer", "minimum": 0, "maximum": 1000 },
              "gateTicks": { "type": "integer", "minimum": 1 },
              "probability": { "type": "integer", "minimum": 0, "maximum": 1000 },
              "swing": { "type": "integer", "minimum": 0, "maximum": 1000 }
            },
            "minProperties": 1,
            "unevaluatedProperties": false
          },
          "stepEvents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "step": { "type": "integer", "minimum": 0 },
                "velocity": { "type": "integer", "minimum": 0, "maximum": 1000 },
                "microTicks": { "type": "integer", "minimum": -1920, "maximum": 1920 },
                "gateTicks": { "type": "integer", "minimum": 1 },
                "probability": { "type": "integer", "minimum": 0, "maximum": 1000 },
                "ratchet": { "type": "integer", "minimum": 1, "maximum": 16 }
              },
              "required": ["step"],
              "minProperties": 2,
              "unevaluatedProperties": false
            }
          }
        },
        "required": ["lane", "grid", "steps"],
        "unevaluatedProperties": false
      }
    }
  },
  "required": ["id", "kind", "lengthTicks", "lanes"],
  "unevaluatedProperties": false
}
